// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── SPPG (Satuan Pelayanan Pemenuhan Gizi) ──────────────────────────────
model Sppg {
  id                  String    @id @default(uuid())
  kode                String?   @unique
  nama                String
  provinsi            String
  kabupatenKota       String    @map("kabupaten_kota")
  kecamatan           String
  kelurahanDesa       String    @map("kelurahan_desa")
  alamat              String?
  latitude            Float?
  longitude           Float?
  isActive            Boolean   @default(true) @map("is_active")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  // ── Status verifikasi BGN ─────────────────────────────────────────
  verificationStatus  String    @default("APPROVED") @map("verification_status")
  // PENDING | APPROVED | REJECTED
  rejectionReason     String?   @map("rejection_reason")
  verifiedBy          String?   @map("verified_by")
  verifiedAt          DateTime? @map("verified_at")

  // ── Status operasional ────────────────────────────────────────────
  operationalStatus   String    @default("ACTIVE") @map("operational_status")
  // ACTIVE | SUSPENDED | INACTIVE
  suspensionReason    String?   @map("suspension_reason")
  suspendedAt         DateTime? @map("suspended_at")

  // ── Detail SPPG ───────────────────────────────────────────────────
  is3t                Boolean   @default(false) @map("is_3t")
  kapasitasPorsi      Int?      @map("kapasitas_porsi")
  penanggungjawab     String?   @map("penanggung_jawab")
  kontak              String?

  users               User[]
  schools             School[]
  procurements        Procurement[]
  productionBatches   ProductionBatch[]
  incidents           FoodSafetyIncident[]

  @@index([provinsi, kabupatenKota])
  @@index([verificationStatus, operationalStatus])
  @@map("sppgs")
}

// ─── USERS ────────────────────────────────────────────────────────────
model User {
  id              String   @id @default(uuid())
  name            String
  email           String   @unique
  passwordHash    String   @map("password_hash")
  // role: "student" | "admin" | "BGN_ADMIN" | "SPPG_ADMIN"
  role            String   @default("student")
  // account_status: PENDING | ACTIVE | REJECTED
  accountStatus   String   @default("ACTIVE") @map("account_status")
  schoolId        String?  @map("school_id")
  sppgId          String?  @map("sppg_id")
  class_          String?  @map("class")
  gender          String?  // 'L' | 'P'
  age             Int?
  profileImageUrl String?  @map("profile_image_url")
  schoolLevel     String?  @map("school_level") // SD | SMP | SMA | SMK

  // ── Alergi Makanan ────────────────────────────────────────────────
  // Nilai yang diizinkan: kacang, telur, susu, ikan, udang, gandum, kedelai, lainnya
  allergies       String[] @default([])
  allergyOther    String?  @map("allergy_other")   // diisi hanya jika "lainnya" dipilih
  allergyFilled   Boolean  @default(false) @map("allergy_filled") // false = belum pernah diisi

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  school              School?              @relation(fields: [schoolId], references: [id])
  sppg                Sppg?                @relation(fields: [sppgId], references: [id])
  scanHistories       ScanHistory[]
  dailyNutrition      DailyNutrition[]
  menuRequests        MenuRequest[]
  foodRatings         FoodRating[]
  foodFeedbacks       FoodFeedback[]
  reportedIncidents   FoodSafetyIncident[] @relation("IncidentReporter")
  notifications       Notification[]

  @@index([role])
  @@index([accountStatus])
  @@map("users")
}

// ─── NOTIFICATIONS (Notifikasi distribusi ompreng, dll.) ──────────────
model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  title     String
  body      String
  type      String   @default("distribution")
  data      Json?
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

// ─── SCHOOLS ─────────────────────────────────────────────────────────
model School {
  id      String  @id @default(uuid())
  name    String
  level   String  // SD | SMP | SMA | SMK
  address String?
  city    String?
  sppgId  String? @map("sppg_id")

  sppg       Sppg?                @relation(fields: [sppgId], references: [id])
  users      User[]
  mbgMenus   MbgMenu[]
  deliveries Delivery[]
  incidents  FoodSafetyIncident[]

  @@map("schools")
}

// ─── FOODS ───────────────────────────────────────────────────────────
model Food {
  id          String  @id @default(uuid())
  name        String
  category    String  // Karbohidrat | Protein Hewani | Protein Nabati | Sayuran | Buah | Minuman
  imageUrl    String? @map("image_url")
  description String?
  isActive    Boolean @default(true) @map("is_active")

  nutrition   Nutrition?
  menuItems   MbgMenuItem[]
  predictions Prediction[]
  foodRatings FoodRating[]
  feedbacks   FoodFeedback[]

  @@map("foods")
}

// ─── NUTRITION ───────────────────────────────────────────────────────
model Nutrition {
  id           String @id @default(uuid())
  foodId       String @unique @map("food_id")
  calories     Float  // kcal per 100g
  protein      Float  // g per 100g
  carbs        Float  // g per 100g
  fat          Float  // g per 100g
  fiber        Float  // g per 100g
  sugar        Float  @default(0)
  sodium       Float  @default(0)
  calcium      Float  @default(0)
  iron         Float  @default(0)
  vitaminC     Float  @default(0) @map("vitamin_c")
  vitaminA     Float  @default(0) @map("vitamin_a")
  portionGram  Float  @default(100) @map("portion_gram")
  cookingMethod String? @map("cooking_method") // "goreng" | "rebus" | "kukus" | "mentah"
  dataSource   String  @default("TKPI 2017") @map("data_source")

  food         Food   @relation(fields: [foodId], references: [id])

  @@map("nutrition")
}

// ─── MBG MENUS ───────────────────────────────────────────────────────
model MbgMenu {
  id         String   @id @default(uuid())
  schoolId   String   @map("school_id")
  date       DateTime @db.Date
  dayName    String   @map("day_name")

  school     School        @relation(fields: [schoolId], references: [id])
  items      MbgMenuItem[]

  @@unique([schoolId, date])
  @@map("mbg_menus")
}

model MbgMenuItem {
  id          String @id @default(uuid())
  menuId      String @map("menu_id")
  foodId      String @map("food_id")
  portionGram Float  @default(100) @map("portion_gram")

  menu        MbgMenu @relation(fields: [menuId], references: [id])
  food        Food    @relation(fields: [foodId], references: [id])

  @@map("mbg_menu_items")
}

// ─── SCAN HISTORY ─────────────────────────────────────────────────────
model ScanHistory {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  imageUrl      String?  @map("image_url")
  scannedAt     DateTime @default(now()) @map("scanned_at")
  totalCalories Float    @default(0) @map("total_calories")
  totalProtein  Float    @default(0) @map("total_protein")
  totalCarbs    Float    @default(0) @map("total_carbs")
  totalFat      Float    @default(0) @map("total_fat")
  totalFiber    Float    @default(0) @map("total_fiber")
  status        String   @default("success") // success | failed | processing
  akgTarget     String?  @map("akg_target") // sasaran AKG MBG yang dipilih user

  // Data Sensorik — indikator penerimaan makanan (bukan kandungan gizi)
  // { taste, salt_level, sweet_level, texture, aroma }
  sensoryData     Json?  @map("sensory_data")

  // Data Konsumsi — { portion_size, leftover_amount, is_finished }
  consumptionData Json?  @map("consumption_data")

  user          User         @relation(fields: [userId], references: [id])
  predictions   Prediction[]

  @@map("scan_history")
}

// ─── PREDICTIONS ──────────────────────────────────────────────────────
model Prediction {
  id                  String  @id @default(uuid())
  scanId              String  @map("scan_id")
  foodId              String  @map("food_id")
  confidence          Float
  portionEstimateGram Float   @default(100) @map("portion_estimate_gram")
  weightInputGram     Float?  @map("weight_input_gram") // berat yang diinput user (opsional)
  calories            Float?
  protein             Float?
  carbs               Float?
  fat                 Float?

  scan                ScanHistory @relation(fields: [scanId], references: [id])
  food                Food        @relation(fields: [foodId], references: [id])

  @@map("predictions")
}

// ─── DAILY NUTRITION ──────────────────────────────────────────────────
model DailyNutrition {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  date           DateTime @db.Date
  totalCalories  Float    @default(0) @map("total_calories")
  totalProtein   Float    @default(0) @map("total_protein")
  totalCarbs     Float    @default(0) @map("total_carbs")
  totalFat       Float    @default(0) @map("total_fat")
  totalFiber     Float    @default(0) @map("total_fiber")
  totalScans     Int      @default(0) @map("total_scans")
  caloriesTarget Float    @default(2000) @map("calories_target")
  proteinTarget  Float    @default(60)   @map("protein_target")

  user           User     @relation(fields: [userId], references: [id])

  @@unique([userId, date])
  @@map("daily_nutrition")
}

// ─── MENU REQUESTS (Permintaan Menu) ──────────────────────────────────
model MenuRequest {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  menuName    String   @map("menu_name")
  reason      String?
  status      String   @default("received")
  // received | reviewing | considered | approved | rejected
  adminNote   String?  @map("admin_note")
  submittedAt DateTime @default(now()) @map("submitted_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user        User     @relation(fields: [userId], references: [id])

  @@map("menu_requests")
}

// ─── FOOD RATINGS (Makanan Favorit) ───────────────────────────────────
model FoodRating {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  foodId      String?  @map("food_id")
  foodName    String   @map("food_name") // nama bebas jika tidak ada di database
  rating      Int      // 1-5
  reason      String?
  ratedAt     DateTime @default(now()) @map("rated_at")

  user        User     @relation(fields: [userId], references: [id])
  food        Food?    @relation(fields: [foodId], references: [id])

  @@map("food_ratings")
}

// ─── FOOD FEEDBACKS (Feedback & Sisa Makanan) ─────────────────────────
model FoodFeedback {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  foodId          String?  @map("food_id")
  foodName        String   @map("food_name")

  // Penilaian sensorik (1-5)
  tastRating      Int?     @map("taste_rating")
  textureRating   Int?     @map("texture_rating")
  aromaRating     Int?     @map("aroma_rating")
  portionRating   Int?     @map("portion_rating")
  satisfactionRating Int?  @map("satisfaction_rating")

  // Status konsumsi (bukan berat, melainkan pilihan user)
  consumptionStatus String? @map("consumption_status")
  // "habis" | "sebagian" | "hampir_tidak"

  suggestion      String?
  submittedAt     DateTime @default(now()) @map("submitted_at")

  user            User     @relation(fields: [userId], references: [id])
  food            Food?    @relation(fields: [foodId], references: [id])

  @@map("food_feedbacks")
}

// ─── PROCUREMENTS (Pengadaan Hulu) ───────────────────────────────────────
model Procurement {
  id           String   @id @default(uuid())
  sppgId       String   @map("sppg_id")
  supplierName String   @map("supplier_name")
  itemName     String   @map("item_name")
  quantity     Decimal  @db.Decimal(12, 2)
  unit         String
  procuredAt   DateTime @default(now()) @map("procured_at")
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  sppg         Sppg     @relation(fields: [sppgId], references: [id], onDelete: Cascade)

  @@index([sppgId, procuredAt])
  @@map("procurements")
}

// ─── PRODUCTION BATCHES (Produksi Tengah) ─────────────────────────────────
model ProductionBatch {
  id               String    @id @default(uuid())
  sppgId           String    @map("sppg_id")
  batchDate        DateTime  @db.Date @map("batch_date")
  menuName         String    @map("menu_name")
  portionsPlanned  Int       @default(0) @map("portions_planned")
  portionsProduced Int       @default(0) @map("portions_produced")
  // PASSED | FAILED | PENDING
  qcStatus         String    @default("PENDING") @map("qc_status")
  qcNotes          String?   @map("qc_notes")
  finishedAt       DateTime? @map("finished_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  sppg             Sppg       @relation(fields: [sppgId], references: [id], onDelete: Cascade)
  deliveries       Delivery[]

  @@index([sppgId, batchDate])
  @@map("production_batches")
}

// ─── DELIVERIES (Distribusi Hilir) ────────────────────────────────────────
model Delivery {
  id          String    @id @default(uuid())
  batchId     String    @map("batch_id")
  schoolId    String    @map("school_id")
  portions    Int       @default(0)
  // PREPARED | SENT | RECEIVED
  status      String    @default("PREPARED")
  sentAt      DateTime? @map("sent_at")
  receivedAt  DateTime? @map("received_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  batch        ProductionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  school       School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([sentAt])
  @@map("deliveries")
}

// ─── FOOD SAFETY INCIDENTS (Insiden Keamanan Pangan) ─────────────────────
model FoodSafetyIncident {
  id            String    @id @default(uuid())
  sppgId        String    @map("sppg_id")
  schoolId      String?   @map("school_id")
  reportedBy    String    @map("reported_by")
  incidentDate  DateTime  @db.Date @map("incident_date")
  // LOW | MEDIUM | HIGH
  severity      String    @default("LOW")
  affectedCount Int       @default(0) @map("affected_count")
  description   String
  // OPEN | INVESTIGATING | RESOLVED
  status        String    @default("OPEN")
  resolvedAt    DateTime? @map("resolved_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  sppg          Sppg    @relation(fields: [sppgId], references: [id], onDelete: Cascade)
  school        School? @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  reporter      User    @relation("IncidentReporter", fields: [reportedBy], references: [id], onDelete: Cascade)

  @@index([sppgId, incidentDate])
  @@index([status])
  @@map("food_safety_incidents")
}
