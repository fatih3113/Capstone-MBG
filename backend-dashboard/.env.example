# Backend Dashboard – Environment Variables
# Salin file ini menjadi .env dan isi nilai yang sesuai

# ── Server ─────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── Database (PostgreSQL) ──────────────────────────────────
# Database yang sama dengan backend Flutter
DATABASE_URL="postgresql://postgres:password@localhost:5432/mbg_nutrition_db"

# ── JWT (secret TERPISAH dari backend Flutter) ────────────
# Ganti dengan nilai acak yang kuat sebelum production
JWT_SECRET_DASHBOARD="foodler_dashboard_super_secret_change_in_production_2025"
JWT_EXPIRES_IN=8h

# ── CORS ───────────────────────────────────────────────────
# Hanya izinkan frontend dashboard (Vite dev + production)
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:4173"
